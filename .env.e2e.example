# Copy this file to .env, replace both token placeholders, and keep .env local.
# Token A must be selected only for GH_BABYSITTER_E2E_REPO.
GH_TOKEN=github_pat_replace_with_primary_repo_token
GH_BABYSITTER_E2E_REPO=Alex-Kopylov/gh-babysitter-e2e-20260712060729

# Token B must be selected only for GH_BABYSITTER_E2E_SECONDARY_REPO.
GH_BABYSITTER_E2E_SECONDARY_TOKEN=github_pat_replace_with_secondary_repo_token
GH_BABYSITTER_E2E_SECONDARY_REPO=Alex-Kopylov/gh-babysitter-e2e-parallel-20260712064258

# Never let a release/CI run silently skip the negative authorization matrix.
GH_BABYSITTER_E2E_REQUIRE_NEGATIVE=1
