[flake8]
# Pydantic-specific linting via flake8-pydantic
# Async anti-pattern detection via flake8-async

# Only enable Pydantic and Async rules (other linting via ruff)
select = PYD,ASYNC

# flake8's built-in excludes omit .venv, so a bare invocation would otherwise
# scan the whole virtualenv.
extend-exclude = .venv,.git,__pycache__
